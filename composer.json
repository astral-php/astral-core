{
  "name": "astral-php/astral-core",
  "description": "Astral Core — moteur PHP 8.3+ (HTTP, DI, router, auth, DAO, vues, CLI) pour les applications et composants Astral",
  "type": "library",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "astral",
    "php",
    "mvc",
    "framework",
    "microframework",
    "core",
    "di",
    "psr"
  ],
  "homepage": "https://github.com/astral-php/astral-core",
  "require": {
    "php": "^8.3",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/Core/",
      "Database\\": "src/Database/",
      "Controller\\": "src/Controller/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
